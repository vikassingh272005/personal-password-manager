# Production environment file for docker-compose.prod.yml.
# Copy to .env.prod (git-ignored) and fill in real values:
#   cp .env.prod.example .env.prod
# Generate secrets with: openssl rand -hex 32

# The public domain that points at this host (A/AAAA record required).
DOMAIN=vault.example.com

# Optional: email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# 32-byte hex secrets — generate fresh values, never reuse across environments.
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
SESSION_SECRET=change-me-openssl-rand-hex-32
AUDIT_IP_SALT=change-me-openssl-rand-hex-32

# Encrypted snapshot history kept per user (newest is always kept).
SNAPSHOT_RETENTION_COUNT=20
