DATABASE_URL=postgres://postgres:postgres@localhost:5432/secure_vault
SESSION_SECRET=change-me-to-a-secure-random-string
PORT=3001
CORS_ORIGINS=http://localhost:3000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# Comma-separated emails granted the admin role. Leave empty in development
# to make the first registered account an admin. In production an empty list
# DISABLES that bootstrap — promote an admin explicitly via SQL instead
# (see secure-vault/docs/operations.md).
ADMIN_EMAILS=
# Secure cookie flag. Default: on in production (APP_ENV=production), off
# otherwise. Only disable explicitly for plain-HTTP production (not advised).
COOKIE_SECURE=
# How many encrypted vault snapshots to retain per user (cleanup runs hourly;
# the newest snapshot is always kept). 0 keeps everything.
SNAPSHOT_RETENTION_COUNT=20
# development | production. Production forces Secure cookies and disables
# the first-user-becomes-admin bootstrap.
APP_ENV=development
# Per-deployment random salt used to hash client IPs in the audit log.
# Generate once (e.g. `openssl rand -hex 32`) and keep it stable so audit
# entries remain correlatable. Raw IPs are never stored.
AUDIT_IP_SALT=change-me-to-a-secure-random-string
